# A. EXCLUDED FROM ALL MODULE IMMUNITIES
# ------------------------------------------------------------------------------
# Bosses and encounters designed around full CC/Stun/Interrupt vulnerability:
# - 15543: Princess Yauj (AQ40 - Bug Trio: Great Heal must be stunned, feared, or kicked)
# - 3673:  Lord Serpentis (Wailing Caverns - Healing Touch & Slumber)
# - 3669:  Lord Cobrahn (Wailing Caverns - Healing Touch & Slumber)
# - 3670:  Lord Pythas (Wailing Caverns - Healing Touch & Slumber)
# - 3671:  Lady Anacondra (Wailing Caverns - Healing Touch & Slumber)
EpicBosses.Immunities.ExcludedCreatures = "15543,3673,3669,3670,3671"

# ------------------------------------------------------------------------------
# B. EXCLUDED FROM STUN IMMUNITY ONLY
# ------------------------------------------------------------------------------
# Bosses that must remain stunnable for specific encounter mechanics:
