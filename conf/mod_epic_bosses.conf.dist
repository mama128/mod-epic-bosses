# - 1853:  Darkmaster Gandling (Scholomance - Stunnable to prevent room teleports)
# - 15516: Battleguard Sartura (AQ40 - Stunnable outside Whirlwind)
EpicBosses.Immunities.ExcludedStunCreatures = "10440,1853,15516"

